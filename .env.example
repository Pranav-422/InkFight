DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=

# AI that reads drawings and picks moves/style/name. Gemini wins if both are set.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated emails of admins (/admin panel)
ADMIN_EMAILS=

# Online fallback when two devices can't link directly (src/game/relay.ts): a Supabase project's
# URL and publishable key (Project Settings -> API Keys). Public values; baked in at build time.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Password reset emails (src/lib/mail.ts) via https://resend.com. Without a verified domain Resend only
# delivers to the Resend account owner's own address. MAIL_FROM after verifying a domain, e.g. "InkFight <noreply@yourdomain>".
RESEND_API_KEY=""
MAIL_FROM=""
