GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Comma-separated emails of admins (/admin panel)
ADMIN_EMAILS=

# Online fallback when two devices can't link directly (src/game/relay.ts): a Supabase project's
