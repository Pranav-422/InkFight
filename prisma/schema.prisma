generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  buff         Boolean     @default(false) // admin only: their own side hits harder and takes less (fights not recorded)
  createdAt    DateTime    @default(now())
  characters   Character[]
}

model Character {
  id            String   @id @default(cuid())
  name          String
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerHandle   String
  imageUrl      String
  class         String
  hp            Int
  atk           Int
  def           Int
  spd           Int
  agi           Int      @default(70) // AGI: jump, air control, hit recovery
  iq            Int      @default(70) // IQ: energy gain, magic damage
  element       String   @default("NONE") // FIRE, ELECTRIC, FROST, POISON, BLEED, GRAVITY, NONE (src/lib/stats.ts)
  item          String?  // held item (sword, mace, book, staff, shield, bow, nothing); null → from class
  specialMove   String
  specialDesc   String   @default("")
  flavorText    String
  detectedItems String   // JSON: rule-based features, raw model proposal, stat breakdown
  pose          String?  // JSON body keypoints (0..1 of the photo) from vision; null → estimated in the browser
  rotation      Int      @default(0) // degrees clockwise (0/90/180/270) to stand a sideways drawing upright
  flipItem      Boolean  @default(false) // owner: the held item came out upside down, swap its grip and tip
  specialKind   String?  // special-move building block (src/game/moves.ts); null → class default
  style         String?  // fighting style (Boxing, Taekwondo, ...); null → class default
  sideSkill     String?  // side skill (src/game/moves.ts SIDE_SKILLS); null → class default
  cpu           Boolean  @default(true)  // admin: the computer may play this design
  hidden        Boolean  @default(false) // admin: kept off gallery, leaderboard and CPU lists
  createdAt     DateTime @default(now())

  battlesAsA Battle[] @relation("CharacterA")
  battlesAsB Battle[] @relation("CharacterB")
}

model Battle {
  id           String    @id @default(cuid())
  characterAId String
  characterBId String
  characterA   Character @relation("CharacterA", fields: [characterAId], references: [id], onDelete: Cascade)
  characterB   Character @relation("CharacterB", fields: [characterBId], references: [id], onDelete: Cascade)
  winnerId     String
  matchKey     String?   @unique // "<room>:<random id>" so a reported match is saved once
  log          String    // JSON summary: wins, damage, rounds
  createdAt    DateTime  @default(now())
}

// WebRTC signaling for peer-to-peer matches. The fight itself never touches the server.
model Room {
  code          String   @id
  hostUserId    String
  hostFighterId String
  offer         String   // host SDP (ICE gathered)
  guestUserId   String?
  guestFighterId String?
  answer        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Fixed-window rate limit counters (src/lib/rateLimit.ts). Key = "<action>:<who>".
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
